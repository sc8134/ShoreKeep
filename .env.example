# --- Core ---
DATA_DIR=./data
PUBLIC_BASE_URL=http://127.0.0.1:8000
RETENTION_SECONDS=3600
MAX_FILESIZE_MB=2048
JOB_TIMEOUT_SECONDS=1800
MAX_QUEUE_DEPTH=50

# --- Accounts / sessions ---
# REQUIRED in production: long random string, used for cookie encryption and IP hashing
# Generate e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
SESSION_DAYS=30
# Set true when served over HTTPS so the session cookie is Secure
COOKIE_SECURE=false

# --- Free-tier limits ---
ANON_JOBS_PER_IP_HOUR=5
FREE_JOBS_PER_USER_HOUR=20
PRO_JOBS_PER_USER_HOUR=100
ANON_MAX_ACTIVE_JOBS=1
FREE_MAX_ACTIVE_JOBS=2
PRO_MAX_ACTIVE_JOBS=4
# Guests can only pick this preset or lower; audio is always allowed. Empty disables the cap.
ANON_MAX_PRESET=720p

# --- Cloudflare Turnstile (bot check) ---
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- BYO cookies ---
MAX_COOKIE_KB=256

# --- Desktop companion ---
# Lifetime of the one-time shorekeep:// pairing link (seconds)
AGENT_PAIR_TTL_SECONDS=300
# How long desktop usage rows are kept for hourly quota accounting
DESKTOP_USAGE_RETENTION_DAYS=30

# --- Transfer engines ---
MYDL_CONNECTIONS=8
# Leave empty to auto-detect ffmpeg (PATH, then imageio-ffmpeg)
FFMPEG_BIN=

# --- Storage: local | r2 ---
STORAGE_BACKEND=local
# R2_BUCKET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
